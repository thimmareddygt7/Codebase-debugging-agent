# Model Provider: "groq" (ultra-fast cloud LPU) or "ollama" (local)
MODEL_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b
FALLBACK_MODEL=openai/gpt-oss-20b

# Local Ollama (optional fallback)
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Vector Store and Persistence Paths
VECTOR_STORE_DIR=vector_store
SESSION_DB_PATH=data/sessions.db

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# LangSmith Observability & Tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key_here
LANGSMITH_PROJECT=codebase-debugging-agent

# --- API security ---
# Required for the API to accept requests. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEYS=change_me_to_a_long_random_key
# Local development only (never in production): allow requests with no key configured
ALLOW_INSECURE_NO_AUTH=false
# Allows /tests/run and run_tests_command on /fix/apply. Keep false on public deployments.
ENABLE_COMMAND_EXECUTION=false
# Comma-separated browser origins allowed by CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Auto-fix loop (POST /debug/fix) ---
FIX_MAX_STEPS=12
FIX_MAX_TOKENS=2000
FIX_TEST_TIMEOUT=60
FIX_MAX_SECONDS=300
# "local" runs tests in a scrubbed subprocess; "docker" runs them in a locked-down container
# (no network, read-only fs). Use docker for any repository you do not fully trust.
SANDBOX_MODE=local
SANDBOX_DOCKER_IMAGE=python:3.11-slim
# Extra directories the API may index / debug (comma-separated, absolute paths)
INDEX_ALLOWED_ROOTS=
TARGET_REPO_DIR=

# --- Retrieval / Q&A agent ---
ENABLE_RERANKER=true
RERANK_OVERSAMPLE=3
LLM_MAX_TOKENS=800
TOOL_SNIPPET_CHARS=750
TOOL_TOP_K_MAX=3
LOG_LEVEL=INFO

